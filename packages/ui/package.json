{
  "name": "@wasalni/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared shadcn/ui primitives + Wasalni-specific compositions. Consumed by passenger-web and driver-web; React Server Component compatible.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/cn": "./src/lib/cn.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "lint": "echo 'lint runs at app boundary' && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@wasalni/config-tsconfig": "workspace:*",
    "@wasalni/config-vitest": "workspace:*",
    "jsdom": "^26.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
