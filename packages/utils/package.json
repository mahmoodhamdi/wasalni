{
  "name": "@wasalni/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic utilities: phone formatting, currency, date, money, distance.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./phone": "./src/phone.ts",
    "./currency": "./src/currency.ts",
    "./date": "./src/date.ts",
    "./distance": "./src/distance.ts"
  },
  "scripts": {
    "lint": "echo 'lint runs at app boundary' && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "@wasalni/config-tsconfig": "workspace:*",
    "@wasalni/config-vitest": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
