{
  "name": "@wasalni/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed REST client for the Wasalni backend. Used by both apps and by Next.js Route Handlers.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "lint": "echo 'lint runs at app boundary' && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "echo 'tests added in PR 21' && exit 0"
  },
  "dependencies": {
    "@wasalni/schemas": "workspace:*",
    "@wasalni/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@wasalni/config-tsconfig": "workspace:*",
    "typescript": "^5.7.3"
  }
}
