# ===========================================
# Wasalni Environment Configuration
# ===========================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wasalni
MONGO_USERNAME=wasalni
MONGO_PASSWORD=wasalni123

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=wasalni123

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase (for Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# SMS Provider (for OTP)
SMS_PROVIDER=mock
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=Wasalni

# Admin Dashboard
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Storage (for document uploads)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=wasalni-uploads
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=me-south-1

# Feature Flags
ENABLE_SURGE_PRICING=true
ENABLE_SCHEDULED_RIDES=false
ENABLE_INTERCITY_RIDES=false
