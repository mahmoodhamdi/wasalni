# ===========================================
# Wasalni Environment Configuration
# ===========================================

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wasalni
MONGO_USERNAME=wasalni
MONGO_PASSWORD=wasalni123

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=wasalni123

# JWT (IMPORTANT: Change these in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase (for Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# SMS Provider (for OTP)
# Options: mock (development), twilio, vonage
SMS_PROVIDER=mock
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret
SMS_FROM_NUMBER=+201000000000
SMS_SENDER_ID=Wasalni

# OTP Settings
OTP_EXPIRES_IN=5
OTP_LENGTH=6

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin Dashboard
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Storage (for document uploads)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=wasalni-uploads
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=me-south-1

# App Settings
DEFAULT_COMMISSION=20
BOOKING_FEE=3
MAX_SEARCH_RADIUS=5
DRIVER_SEARCH_TIMEOUT=60
CANCELLATION_FEE=10
FREE_CANCELLATION_MINUTES=2
SOS_PHONE=122
SUPPORT_PHONE=01000000000
FRONTEND_URL=https://wasalni.app

# Feature Flags
ENABLE_SURGE_PRICING=true
ENABLE_SCHEDULED_RIDES=true
ENABLE_INTERCITY_RIDES=false
